#!/bin/bash
set -xeuo pipefail

install -Dpm0644 -t /usr/share/flatpak/remotes.d/ "$SRCDIR/cache/flathub.flatpakrepo"

niri --version | grep -i -E "niri [[:digit:]]*\.[[:digit:]]*"

install -d /usr/share/barusu/
sed --sandbox -i -e '/gnome_keyring.so/ s/-auth/auth/ ; /gnome_keyring.so/ s/-session/session/' /etc/pam.d/greetd
fc-cache --force --really-force --system-only --verbose # recreate font-cache to pick up the added fonts

# These files NEED to be on the image.
grep -F -e "Comment=Central repository of Flatpak applications" /usr/share/flatpak/remotes.d/flathub.flatpakrepo
stat /usr/share/flatpak/remotes.d/flathub.flatpakrepo

for binary in bjust gum chezmoi just niri dms dms-greeter ghostty greetd flatpak podman wpctl playerctl brightnessctl; do
    command -v "$binary"
done
stat /usr/share/applications/com.mitchellh.ghostty.desktop
niri validate -c /usr/share/barusu/zdots/dot_config/niri/config.kdl
just --justfile /usr/share/barusu/just/00-system.just --summary
systemctl set-default graphical.target
install -d /usr/share/barusu/build-info
rpm -qa --qf '%{NAME}\t%{VERSION}-%{RELEASE}\t%{ARCH}\n' | sort > /usr/share/barusu/build-info/packages.tsv
ln -s fedora-release /usr/lib/system-release


(
    . /usr/lib/os-release
    PROJECT_URL=""
    if [ -f /usr/share/barusu/project-url ]; then
        PROJECT_URL="$(cat /usr/share/barusu/project-url)"
    fi
    cat > /usr/lib/os-release <<EOF
NAME="Barusu"
ID=barusu
ID_LIKE=fedora
PRETTY_NAME="Barusu"
VERSION="$VERSION"
VERSION_ID="$VERSION_ID"
ANSI_COLOR="0;36"
LOGO=fedora-logo-icon
HOME_URL="$PROJECT_URL"
DOCUMENTATION_URL="$PROJECT_URL"
DEFAULT_HOSTNAME=barusu
EOF
    printf 'Barusu\nKernel \\r on an \\m (\\l)\n' > /usr/lib/issue
)
