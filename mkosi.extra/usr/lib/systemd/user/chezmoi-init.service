[Unit]
Description=Initializes Chezmoi if directory is missing
ConditionPathExists=!%h/.config/barusu/chezmoi

[Service]
ExecStart=mkdir -p %h/.config/barusu/chezmoi
ExecStart=touch %h/.config/barusu/chezmoi/chezmoi.toml
ExecStart=chezmoi apply -S /usr/share/barusu/zdots --config %h/.config/barusu/chezmoi/chezmoi.toml
Type=oneshot

[Install]
WantedBy=graphical-session-pre.target
